<%- include('../partials/header') %>

<div class="page-header">
    <p class="eyebrow">Admin</p>
    <h1>Stats Dashboard</h1>
</div>

<div class="actions-row">
    <a href="/admin/stats/export" class="btn-outline">Export CSV</a>
</div>

<div class="stat-tiles">
    <div class="stat-tile">
        <span class="stat-tile-value"><%= totalUsers %></span>
        <span class="stat-tile-label">Total Users</span>
    </div>
    <div class="stat-tile">
        <span class="stat-tile-value"><%= totalTrips %></span>
        <span class="stat-tile-label">Total Trips</span>
    </div>
    <div class="stat-tile">
        <span class="stat-tile-value"><%= totalItems %></span>
        <span class="stat-tile-label">Total Itinerary Items</span>
    </div>
</div>

<h2 class="section-heading">Destination Popularity</h2>
<% if (destinationPopularity.length === 0) { %>
    <p>No destinations yet.</p>
<% } else { %>
    <% const maxDestTotal = Math.max(1, ...destinationPopularity.map(d => d.total)); %>
    <div class="bar-chart">
        <% destinationPopularity.forEach(d => { %>
            <div class="bar-row">
                <span class="bar-label"><%= d.name %>, <%= d.country %></span>
                <div class="bar-track">
                    <div class="bar-fill" style="width: <%= Math.round((d.total / maxDestTotal) * 100) %>%"></div>
                </div>
                <span class="bar-value"><%= d.total %></span>
            </div>
        <% }) %>
    </div>
<% } %>

<h2 class="section-heading">Itinerary Items by Category</h2>
<% if (itemsByCategory.length === 0) { %>
    <p>No itinerary items yet.</p>
<% } else { %>
    <% const maxCatTotal = Math.max(1, ...itemsByCategory.map(c => c.total)); %>
    <div class="bar-chart">
        <% itemsByCategory.forEach(row => { %>
            <div class="bar-row">
                <span class="bar-label"><%= row.category %></span>
                <div class="bar-track">
                    <div class="bar-fill" style="width: <%= Math.round((row.total / maxCatTotal) * 100) %>%"></div>
                </div>
                <span class="bar-value"><%= row.total %></span>
            </div>
        <% }) %>
    </div>
<% } %>

<h2 class="section-heading">Trips by Month</h2>
<% if (tripsByMonth.length === 0) { %>
    <p>No trips yet.</p>
<% } else { %>
    <% const monthNames = ['', 'January', 'February', 'March', 'April', 'May', 'June',
                            'July', 'August', 'September', 'October', 'November', 'December']; %>
    <% const maxMonthTotal = Math.max(1, ...tripsByMonth.map(m => m.total)); %>
    <div class="bar-chart">
        <% tripsByMonth.forEach(row => { %>
            <div class="bar-row">
                <span class="bar-label"><%= monthNames[row.month] %></span>
                <div class="bar-track">
                    <div class="bar-fill" style="width: <%= Math.round((row.total / maxMonthTotal) * 100) %>%"></div>
                </div>
                <span class="bar-value"><%= row.total %></span>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/footer') %>
