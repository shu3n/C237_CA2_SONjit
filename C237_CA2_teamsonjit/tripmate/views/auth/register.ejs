<%- include('../partials/header') %>

<p class="eyebrow">Get started</p>
<h1>Register</h1>

<% if (errors && errors.length > 0) { %>
    <ul class="error-list">
        <% errors.forEach(function(error) { %>
            <li><%= error %></li>
        <% }) %>
    </ul>
<% } %>

<div class="card">
    <form action="/register" method="POST">
        <label>Username</label>
        <input type="text" name="username" value="<%= formData.username || '' %>" required>

        <label>Email</label>
        <input type="email" name="email" value="<%= formData.email || '' %>" required>

        <label>Password</label>
        <input type="password" name="password" minlength="8"
               pattern="(?=.*[^A-Za-z0-9]).{8,}"
               title="At least 8 characters, including 1 special character" required>
        <p class="field-hint">At least 8 characters, including 1 special character.</p>

        <button type="submit">Register</button>
    </form>
</div>
<p>Already have an account? <a href="/login">Login here</a></p>

<%- include('../partials/footer') %>
