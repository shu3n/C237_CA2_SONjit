<%- include('../partials/header') %>

<p class="eyebrow"><%= trip.trip_name %></p>
<h1>Add Itinerary Item</h1>

<% if (errors && errors.length > 0) { %>
    <ul class="error-list">
        <% errors.forEach(function(error) { %>
            <li><%= error %></li>
        <% }) %>
    </ul>
<% } %>

<div class="card">
    <form action="/trips/<%= trip.trip_id %>/items/create" method="POST">
        <label>Item Name</label>
        <input type="text" name="item_name" value="<%= formData.item_name || '' %>" required>

        <label>Category</label>
        <select name="category" required>
            <option value="">-- Select category --</option>
            <option value="flight" <%= formData.category === 'flight' ? 'selected' : '' %>>Flight</option>
            <option value="hotel" <%= formData.category === 'hotel' ? 'selected' : '' %>>Hotel</option>
            <option value="activity" <%= formData.category === 'activity' ? 'selected' : '' %>>Activity</option>
            <option value="food" <%= formData.category === 'food' ? 'selected' : '' %>>Food</option>
            <option value="transport" <%= formData.category === 'transport' ? 'selected' : '' %>>Transport</option>
            <option value="other" <%= formData.category === 'other' ? 'selected' : '' %>>Other</option>
        </select>

        <label>Date</label>
        <input type="date" name="item_date" value="<%= formData.item_date || '' %>"
               min="<%= trip.start_date.toISOString().split('T')[0] %>"
               max="<%= trip.end_date.toISOString().split('T')[0] %>" required>

        <label>Time</label>
        <input type="time" name="item_time" value="<%= formData.item_time || '' %>">

        <label>Location</label>
        <input type="text" name="location" value="<%= formData.location || '' %>">

        <label>Cost</label>
        <input type="number" step="0.01" min="0" name="cost" value="<%= formData.cost || '' %>">

        <label>Notes</label>
        <textarea name="notes"><%= formData.notes || '' %></textarea>

        <button type="submit">Add Item</button>
    </form>
    <a href="/trips/<%= trip.trip_id %>" class="btn-outline" style="margin-top:16px; display:inline-block;">&larr; Back to Trip</a>
</div>

<%- include('../partials/footer') %>
