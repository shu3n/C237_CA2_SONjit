<%- include('../partials/header') %>

<p class="eyebrow"><%= trip.trip_name %></p>
<h1>Edit itinerary item</h1>
<div class="card">
    <form action="/trips/<%= trip.trip_id %>/items/<%= item.item_id %>/edit" method="POST">
        <label>Item name</label>
        <input type="text" name="item_name" value="<%= item.item_name %>" required>

        <label>Category</label>
        <select name="category">
            <option value="flight" <%= item.category === 'flight' ? 'selected' : '' %>>Flight</option>
            <option value="hotel" <%= item.category === 'hotel' ? 'selected' : '' %>>Hotel</option>
            <option value="activity" <%= item.category === 'activity' ? 'selected' : '' %>>Activity</option>
            <option value="food" <%= item.category === 'food' ? 'selected' : '' %>>Food</option>
            <option value="transport" <%= item.category === 'transport' ? 'selected' : '' %>>Transport</option>
            <option value="other" <%= item.category === 'other' ? 'selected' : '' %>>Other</option>
        </select>

        <label>Date</label>
        <input type="date" name="item_date" value="<%= item.item_date.toISOString().split('T')[0] %>" required>

        <label>Time</label>
        <input type="time" name="item_time" value="<%= item.item_time %>">

        <label>Location</label>
        <input type="text" name="location" value="<%= item.location || '' %>">

        <label>Cost</label>
        <input type="number" step="0.01" name="cost" value="<%= item.cost %>">

        <label>Notes</label>
        <textarea name="notes"><%= item.notes || '' %></textarea>

        <button type="submit">Save changes</button>
    </form>
    <a href="/trips/<%= trip.trip_id %>" class="btn-outline" style="margin-top:16px; display:inline-block;">Cancel</a>
</div>

<%- include('../partials/footer') %>
