<%- include('../partials/header') %>

<div class="page-header">
    <p class="eyebrow">Dashboard</p>
    <h1>Where to?</h1>
</div>

<% if (searchErrors && searchErrors.length > 0) { %>
    <ul class="error-list">
        <% searchErrors.forEach(function(error) { %>
            <li><%= error %></li>
        <% }) %>
    </ul>
<% } %>

<div class="search-bar">
    <form action="/trips/search/results" method="GET" class="search-form" id="trip-search-form">
        <span class="search-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <input type="text" name="keyword" placeholder="Search trips..." value="<%= filters.keyword %>">
        <select name="sort">
            <option value="date_asc" <%= filters.sort === 'date_asc' ? 'selected' : '' %>>Start Date (earliest)</option>
            <option value="date_desc" <%= filters.sort === 'date_desc' ? 'selected' : '' %>>Start Date (latest)</option>
            <option value="budget_asc" <%= filters.sort === 'budget_asc' ? 'selected' : '' %>>Budget (low to high)</option>
            <option value="budget_desc" <%= filters.sort === 'budget_desc' ? 'selected' : '' %>>Budget (high to low)</option>
            <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name (A-Z)</option>
            <option value="name_desc" <%= filters.sort === 'name_desc' ? 'selected' : '' %>>Name (Z-A)</option>
            <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Recently added</option>
        </select>
        <button type="submit" class="btn-outline">Search</button>
    </form>
    <a href="/trips/create/new" class="btn">+ New Trip</a>
</div>

<div class="filter-row">
    <label class="filter-field">
        <span>Access</span>
        <select name="access" form="trip-search-form">
            <option value="all" <%= filters.access === 'all' ? 'selected' : '' %>>All trips</option>
            <option value="owned" <%= filters.access === 'owned' ? 'selected' : '' %>>Owned by me</option>
            <option value="shared" <%= filters.access === 'shared' ? 'selected' : '' %>>Shared with me</option>
        </select>
    </label>
    <label class="filter-field">
        <span>Status</span>
        <select name="status" form="trip-search-form">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Any status</option>
            <option value="upcoming" <%= filters.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
            <option value="ongoing" <%= filters.status === 'ongoing' ? 'selected' : '' %>>Ongoing</option>
            <option value="past" <%= filters.status === 'past' ? 'selected' : '' %>>Past</option>
        </select>
    </label>
    <label class="filter-field">
        <span>Min Budget</span>
        <input type="number" min="0" step="0.01" name="min_budget" form="trip-search-form" value="<%= filters.min_budget %>" placeholder="$0">
    </label>
    <label class="filter-field">
        <span>Max Budget</span>
        <input type="number" min="0" step="0.01" name="max_budget" form="trip-search-form" value="<%= filters.max_budget %>" placeholder="No limit">
    </label>
</div>

<h2 class="section-heading">Find a Traveler</h2>
<form action="/trips/search/user" method="GET" class="user-search-bar">
    <span class="search-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </span>
    <input type="text" name="username" placeholder="Search by username..." value="<%= userSearch ? userSearch.username : '' %>">
    <button type="submit" class="btn-outline">Search</button>
</form>
<% if (userSearch && userSearch.notFound) { %>
    <p class="trip-notes">No user found with the username "<%= userSearch.username %>".</p>
<% } else if (userSearch && userSearch.username) { %>
    <p class="eyebrow">Public trips from @<%= userSearch.username %></p>
<% } %>

<% if (trips.length === 0) { %>
    <p class="trip-notes">
        <% if (userSearch && userSearch.username && !userSearch.notFound) { %>
            @<%= userSearch.username %> has no public trips (or trips shared with you).
        <% } else if (searchPerformed) { %>
            No trips match those filters. Try widening your search.
        <% } else { %>
            You haven't created any trips yet — start with "+ New Trip" above.
        <% } %>
    </p>
<% } %>

<ul class="trip-list">
    <% trips.forEach(trip => { %>
        <li class="trip-card">
            <a href="/trips/<%= trip.trip_id %>" class="trip-card-link">
                <img class="trip-card-image" src="<%- include('../partials/destination-image', { tripName: trip.trip_name }) %>" alt="<%= trip.trip_name %>">
                <div class="trip-card-body">
                    <h3 class="trip-card-title"><%= trip.trip_name %></h3>
                    <p class="trip-card-dates"><%= trip.start_date.toDateString() %> &ndash; <%= trip.end_date.toDateString() %></p>
                    <span class="trip-card-budget">$<%= trip.budget %></span>
                    <% if (trip.access_level === 'view' || trip.access_level === 'edit') { %>
                        <span class="category-badge">Shared (<%= trip.access_level %>)</span>
                    <% } else if (trip.access_level === 'public-view') { %>
                        <span class="category-badge">Public</span>
                    <% } %>
                </div>
            </a>
        </li>
    <% }) %>
</ul>

<%- include('../partials/footer') %>
