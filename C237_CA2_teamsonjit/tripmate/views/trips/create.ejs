<%- include('../partials/header') %>

<p class="eyebrow">New trip</p>
<h1>Create New Trip</h1>

<% if (errors && errors.length > 0) { %>
    <ul class="error-list">
        <% errors.forEach(function(error) { %>
            <li><%= error %></li>
        <% }) %>
    </ul>
<% } %>

<%
    let initialPreviewImage = 'default.jpg';
    if (formData.destination_id && formData.destination_id !== 'other') {
        const matchedDest = destinations.find(d => String(d.destination_id) === String(formData.destination_id));
        if (matchedDest) initialPreviewImage = matchedDest.image_filename || 'default.jpg';
    }
%>

<div class="card">
    <form action="/trips/create" method="POST">
        <label>Trip Name</label>
        <input type="text" name="trip_name" value="<%= formData.trip_name || '' %>" required>

        <label>Destination (optional)</label>
        <select name="destination_id" id="destination_id">
            <option value="" data-image="default.jpg">-- No destination selected --</option>
            <% destinations.forEach(function(dest) { %>
                <option value="<%= dest.destination_id %>" data-image="<%= dest.image_filename || 'default.jpg' %>" <%= String(formData.destination_id) === String(dest.destination_id) ? 'selected' : '' %>>
                    <%= dest.name %>, <%= dest.country %>
                </option>
            <% }) %>
            <option value="other" data-image="default.jpg" <%= formData.destination_id === 'other' ? 'selected' : '' %>>Other (not listed)</option>
        </select>
        <img id="destination-preview" class="destination-preview-image" src="/images/destinations/<%= initialPreviewImage %>" alt="Destination preview">

        <div id="custom-destination-fields" style="<%= formData.destination_id === 'other' ? '' : 'display:none;' %>">
            <label>Custom Destination Name</label>
            <input type="text" name="custom_destination_name" value="<%= formData.custom_destination_name || '' %>">

            <label>Custom Destination Country</label>
            <input type="text" name="custom_destination_country" value="<%= formData.custom_destination_country || '' %>">
        </div>

        <label>Start Date</label>
        <input type="date" name="start_date" value="<%= formData.start_date || '' %>" required>

        <label>End Date</label>
        <input type="date" name="end_date" value="<%= formData.end_date || '' %>" required>

        <label>Budget</label>
        <input type="number" step="0.01" min="0" name="budget" value="<%= formData.budget || '' %>">

        <label>Notes</label>
        <textarea name="notes"><%= formData.notes || '' %></textarea>

        <label>Visibility</label>
        <select name="visibility">
            <option value="private" <%= (formData.visibility || 'private') === 'private' ? 'selected' : '' %>>Private (only you and invited collaborators)</option>
            <option value="public" <%= formData.visibility === 'public' ? 'selected' : '' %>>Public (anyone signed in can view)</option>
        </select>
        <p class="field-hint">Public trips can be viewed by any signed-in user, but only you and your collaborators can edit, delete, or manage sharing.</p>

        <button type="submit">Create Trip</button>
    </form>
</div>

<script>
(function () {
    var select = document.getElementById('destination_id');
    var customFields = document.getElementById('custom-destination-fields');
    var preview = document.getElementById('destination-preview');

    function toggleCustomFields() {
        if (!select || !customFields) return;
        customFields.style.display = select.value === 'other' ? '' : 'none';
    }

    function updatePreviewImage() {
        if (!select || !preview) return;
        var opt = select.options[select.selectedIndex];
        var image = (opt && opt.getAttribute('data-image')) || 'default.jpg';
        preview.src = '/images/destinations/' + image;
    }

    if (select) {
        select.addEventListener('change', function () {
            toggleCustomFields();
            updatePreviewImage();
        });
        toggleCustomFields();
    }
})();
</script>

<%- include('../partials/footer') %>
