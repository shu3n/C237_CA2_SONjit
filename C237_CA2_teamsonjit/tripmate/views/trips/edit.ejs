<%- include('../partials/header') %>

<p class="eyebrow"><%= trip.trip_name %></p>
<h1>Edit Trip</h1>

<% if (errors && errors.length > 0) { %>
    <ul class="error-list">
        <% errors.forEach(function(error) { %>
            <li><%= error %></li>
        <% }) %>
    </ul>
<% } %>

<div class="card">
    <form action="/trips/<%= trip.trip_id %>/edit" method="POST">
        <label>Trip Name</label>
        <input type="text" name="trip_name" value="<%= trip.trip_name %>" required>

        <label>Start Date</label>
        <input type="date" name="start_date" value="<%= trip.start_date instanceof Date ? trip.start_date.toISOString().split('T')[0] : trip.start_date %>" required>

        <label>End Date</label>
        <input type="date" name="end_date" value="<%= trip.end_date instanceof Date ? trip.end_date.toISOString().split('T')[0] : trip.end_date %>" required>

        <label>Budget</label>
        <input type="number" step="0.01" min="0" name="budget" value="<%= trip.budget %>">

        <label>Notes</label>
        <textarea name="notes"><%= trip.notes %></textarea>

        <label>Visibility</label>
        <select name="visibility">
            <option value="private" <%= trip.visibility !== 'public' ? 'selected' : '' %>>Private (only you and invited collaborators)</option>
            <option value="public" <%= trip.visibility === 'public' ? 'selected' : '' %>>Public (anyone signed in can view)</option>
        </select>
        <p class="field-hint">Public trips can be viewed by any signed-in user, but only you and your collaborators can edit, delete, or manage sharing.</p>

        <button type="submit">Save Changes</button>
    </form>
    <a href="/trips/<%= trip.trip_id %>" class="btn-outline" style="margin-top:16px; display:inline-block;">Cancel</a>
</div>

<%- include('../partials/footer') %>
