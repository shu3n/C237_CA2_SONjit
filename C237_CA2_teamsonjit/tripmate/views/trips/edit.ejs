<%- include('../partials/header') %>

<p class="eyebrow"><%= trip.trip_name %></p>
<h1>Edit Trip</h1>
<div class="card">
    <form action="/trips/<%= trip.trip_id %>/edit" method="POST">
        <label>Trip Name</label>
        <input type="text" name="trip_name" value="<%= trip.trip_name %>" required>

        <label>Start Date</label>
        <input type="date" name="start_date" value="<%= trip.start_date.toISOString().split('T')[0] %>" required>

        <label>End Date</label>
        <input type="date" name="end_date" value="<%= trip.end_date.toISOString().split('T')[0] %>" required>

        <label>Budget</label>
        <input type="number" step="0.01" name="budget" value="<%= trip.budget %>">

        <label>Notes</label>
        <textarea name="notes"><%= trip.notes %></textarea>

        <button type="submit">Save Changes</button>
    </form>
    <a href="/trips/<%= trip.trip_id %>" class="btn-outline" style="margin-top:16px; display:inline-block;">Cancel</a>
</div>

<%- include('../partials/footer') %>
